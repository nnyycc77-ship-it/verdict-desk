# Verdict Desk environment. Copy to .env on the host and fill in the
# sandbox values there. .env is gitignored and must never be
# committed, pasted into a submission, or shown in a video.

# PayPal sandbox app credentials (Dashboard -> My Apps & Credentials).
# They live in the server environment only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# This build runs on the sandbox only. The PayPal client refuses any
# other value.
PAYPAL_ENV=sandbox

# Optional: webhook id from the sandbox app's webhook subscription.
# When set, capture confirmation is verified through PayPal's
# verify-webhook-signature API. When empty, webhook events are
# refused and capture confirmation rests on the capture response.
PAYPAL_WEBHOOK_ID=

# Optional: public base URL of this server, used for PayPal return
# and cancel URLs. Defaults to http://localhost:8787.
DESK_BASE_URL=

# Optional pricing (USD) and abuse caps for the hosted demo.
FULL_VERDICT_PRICE_USD=5.00
RECHECK_PRICE_USD=2.00
EVAL_RATE_PER_MIN=10
DESK_DAILY_EVAL_CAP=500

# Optional AI model route. When AI_API_KEY is set, term proposals are
# drafted by the named OpenAI-compatible model endpoint and then
# verified by the deterministic battery like every other proposal.
# When it is empty, proposals come from the local extractor that
# ships with the project. No key is bundled and none is required.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
